---
const useCases = [
  {
    filter: 'salon',
    icon: 'spa',
    title: 'Waxing Salons',
    body: 'Establish instant authority for your premium body waxing studio.',
  },
  {
    filter: 'studio',
    icon: 'droplet',
    title: 'Sugaring Studios',
    body: 'Build a brand around natural, organic hair removal techniques.',
  },
  {
    filter: 'clinic',
    icon: 'bolt',
    title: 'Laser Clinics',
    body: 'Own the digital front door for medical-grade laser hair removal.',
  },
  {
    filter: 'product',
    icon: 'bag',
    title: 'Product Brands',
    body: 'Launch a skincare and waxing product line with a memorable domain.',
  },
  {
    filter: 'ecommerce',
    icon: 'globe',
    title: 'E-Commerce',
    body: 'Dominate online retail for waxing supplies and professional skincare.',
  },
];

const filters = [
  { label: 'All', filter: 'all' },
  { label: 'Salons', filter: 'salon' },
  { label: 'Studios', filter: 'studio' },
  { label: 'Clinics', filter: 'clinic' },
  { label: 'Products', filter: 'product' },
  { label: 'E-Commerce', filter: 'ecommerce' },
];

function iconSvg(name: string) {
  const paths: Record<string, string> = {
    spa: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
    droplet: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
    bag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
    globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  };
  return paths[name] ?? paths.globe;
}
---

<section id="for" class="max-w-5xl mx-auto px-4 sm:px-6 py-20 border-b border-line">
  <div class="max-w-3xl mb-8 reveal">
    <p class="modern-pill mb-4">PERFECT FOR</p>
    <h2 class="font-display text-3xl sm:text-4xl tracking-tight">
      A versatile brand for the modern beauty industry
    </h2>
  </div>

  <!-- Category filter chips -->
  <div class="flex flex-wrap gap-2 mb-8 reveal" role="group" aria-label="Filter use cases">
    {filters.map((u, i) => (
      <button
        type="button"
        data-filter={u.filter}
        class={`usecase-filter px-4 py-2 min-h-[44px] text-sm font-medium rounded-2xl border transition-all ${
          i === 0
            ? 'bg-accent text-on-dark border-accent'
            : 'bg-elevated border-line hover:bg-accent-soft hover:border-accent'
        }`}
      >
        {u.label}
      </button>
    ))}
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {useCases.map((u, i) => (
      <div
        class="usecase-card premium-card rounded-2xl border border-line p-6 text-center reveal"
        data-tags={u.filter}
        style={`--reveal-delay: ${i * 60}ms`}
      >
        <div class="w-12 h-12 rounded-xl bg-accent-soft flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconSvg(u.icon)} />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">{u.title}</h3>
        <p class="text-muted text-sm leading-relaxed">{u.body}</p>
      </div>
    ))}
  </div>
</section>
