---
import { SITE, ACQUISITION_MAILTO, OFFER_MAILTO } from '../config/site';
---

<footer class="border-t border-line bg-surface">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <!-- Sophisticated Domain Acquisition CTA -->
    <div class="relative overflow-hidden rounded-3xl border border-accent/25 bg-gradient-to-br from-elevated via-surface to-orange-950/30 p-6 sm:p-8 md:p-12 mb-12">
      <div
        class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-accent/10 blur-3xl pointer-events-none"
        aria-hidden="true"
      ></div>
      <div
        class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-orange-500/10 blur-3xl pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="text-xs uppercase tracking-[3px] text-accent font-extrabold mb-4">Domain Available for Acquisition</p>
          <h2 class="font-display text-3xl sm:text-4xl tracking-tight mb-4">
            VanityWax.com — A Category-Defining Digital Asset
          </h2>
          <p class="text-muted max-w-xl leading-relaxed">
            Positioned at the intersection of luxury beauty branding, professional hair removal, and premium
            skincare, this domain is a rare strategic asset. Serious buyers may inquire for
            pricing, transfer logistics, and escrow options.
          </p>
        </div>

        <div class="rounded-2xl p-6 sm:p-8 border border-line bg-surface/80" style="backdrop-filter: blur(22px);">
          <p class="text-xs uppercase tracking-[2px] text-muted font-semibold mb-2">Acquisition Contact</p>
          <a
            href={ACQUISITION_MAILTO}
            data-track="footer-email"
            class="block text-xl sm:text-2xl lg:text-3xl font-display text-ink hover:text-accent transition-colors break-all"
          >
            {SITE.email}
          </a>
          <div class="mt-6 flex flex-col gap-3">
            <a
              href={OFFER_MAILTO}
              data-track="footer-inquire"
              class="inline-flex w-full items-center justify-center gap-x-3 px-6 py-4 min-h-[48px] bg-accent text-on-dark font-extrabold rounded-2xl hover:brightness-110 transition-all"
            >
              <span>Inquire About Acquisition</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <button
              id="copyEmailBtn"
              type="button"
              class="inline-flex w-full items-center justify-center gap-x-2 px-6 py-4 min-h-[48px] border border-line hover:bg-elevated font-medium rounded-2xl transition-all text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Copy Email
            </button>
          </div>
          <p class="mt-4 text-[11px] text-muted text-center tracking-wide">
            Confidential inquiries • Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <!-- Internal linking (SEO) -->
    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm font-medium text-muted mb-10">
      <a href="#why" class="hover:text-accent py-2">Why This Domain</a>
      <a href="#detail" class="hover:text-accent py-2">The Industry</a>
      <a href="#for" class="hover:text-accent py-2">Perfect For</a>
      <a href="#acquire" class="hover:text-accent py-2">How to Acquire</a>
      <a href="#offer" class="hover:text-accent py-2">Make an Offer</a>
      <a href="#faq" class="hover:text-accent py-2">FAQ</a>
      <a href="/sitemap-index.xml" class="hover:text-accent py-2">Sitemap</a>
    </nav>

    <!-- Disclaimer -->
    <p class="text-xs text-muted leading-relaxed max-w-4xl mb-10">
      <strong>Disclaimer:</strong> This website is for demonstration and informational purposes only. It does not constitute an offer of services,
      a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
      technologies are based on publicly available information as of October 2026 and are subject to change.
    </p>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-line text-xs text-muted flex flex-col md:flex-row gap-y-4 items-center justify-between">
      <div>&copy; 2026 VanityWax.com. All rights reserved.</div>
      <div class="flex items-center gap-x-5 flex-wrap justify-center">
        <span>Premium domain listing by owner</span>
        <span class="hidden md:inline">&bull;</span>
        <span>Exact-match .com</span>
        <span class="hidden md:inline">&bull;</span>
        <span>Escrow-ready</span>
      </div>
    </div>
  </div>
</footer>
