---
import { SITE, OFFER_MAILTO, BUY_NOW_MAILTO, AGENT_MAILTO } from '../config/site';
---

<section id="acquire" class="max-w-4xl mx-auto px-4 sm:px-6 pb-20 scroll-mt-24">
  <div class="bg-elevated border border-line rounded-3xl overflow-hidden reveal">
    <div class="px-6 sm:px-8 md:px-12 pt-10 pb-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-y-4">
        <div>
          <div class="text-xs font-bold tracking-[2px] text-accent mb-1.5">PREMIUM .COM ACQUISITION</div>
          <div class="font-display text-5xl sm:text-6xl md:text-7xl tracking-tighter font-bold">{SITE.priceLabel}</div>
          <div class="text-muted mt-1">USD • One-time acquisition</div>
        </div>

        <div class="md:text-right flex flex-wrap gap-2">
          <div class="inline-flex items-center gap-x-2 text-sm bg-accent-soft text-accent px-4 h-9 rounded-2xl font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Escrow protected</span>
          </div>
          <div class="inline-flex items-center gap-x-2 text-sm bg-accent-soft text-accent px-4 h-9 rounded-2xl font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>SSL secured</span>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-line px-6 sm:px-8 md:px-12 py-8 bg-surface/40">
      <div class="grid md:grid-cols-3 gap-6 text-sm">
        <div>
          <div class="font-semibold mb-1.5 flex items-center gap-x-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            <span>Secure Transfer</span>
          </div>
          <div class="text-muted">Handled via Escrow.com, Dan.com, or your preferred provider. Full support throughout the process.</div>
        </div>
        <div>
          <div class="font-semibold mb-1.5 flex items-center gap-x-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Fast &amp; Private</span>
          </div>
          <div class="text-muted">Typical closing in 3–10 business days. Discreet transaction available for qualified buyers.</div>
        </div>
        <div>
          <div class="font-semibold mb-1.5 flex items-center gap-x-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>Investment Grade</span>
          </div>
          <div class="text-muted">Strong semantic value + explosive category growth + .com equity = exceptional long-term digital asset.</div>
        </div>
      </div>
    </div>

    <!-- Three-step acquisition path -->
    <div class="border-t border-line px-6 sm:px-8 md:px-12 py-8">
      <div class="text-xs font-bold tracking-[2px] text-muted mb-4">HOW TO ACQUIRE</div>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="flex gap-3 items-start rounded-2xl border border-line p-4">
          <div class="w-8 h-8 shrink-0 rounded-xl bg-accent text-on-dark flex items-center justify-center font-mono font-bold">1</div>
          <div>
            <div class="font-semibold text-sm">Submit Your Offer</div>
            <div class="text-muted text-xs mt-0.5">Use the form below or email directly. All serious inquiries get a personal reply.</div>
          </div>
        </div>
        <div class="flex gap-3 items-start rounded-2xl border border-line p-4">
          <div class="w-8 h-8 shrink-0 rounded-xl bg-accent text-on-dark flex items-center justify-center font-mono font-bold">2</div>
          <div>
            <div class="font-semibold text-sm">Secure Transaction</div>
            <div class="text-muted text-xs mt-0.5">Escrow.com, Dan.com, or your attorney/escrow service — full buyer protection.</div>
          </div>
        </div>
        <div class="flex gap-3 items-start rounded-2xl border border-line p-4">
          <div class="w-8 h-8 shrink-0 rounded-xl bg-accent text-on-dark flex items-center justify-center font-mono font-bold">3</div>
          <div>
            <div class="font-semibold text-sm">Fast Domain Transfer</div>
            <div class="text-muted text-xs mt-0.5">Registrar push or auth-code transfer within 1–3 business days after funds clear.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 sm:px-8 md:px-12 py-8 border-t border-line flex flex-col sm:flex-row gap-4">
      <a
        href={OFFER_MAILTO}
        data-track="acquire-make-offer"
        class="flex-1 inline-flex items-center justify-center gap-x-3 min-h-[56px] rounded-2xl bg-accent text-on-dark font-semibold text-lg hover:brightness-110 active:scale-[0.985] transition-all"
      >
        <span>Make an Offer</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href={BUY_NOW_MAILTO}
        data-track="acquire-buy-now"
        class="flex-1 inline-flex items-center justify-center gap-x-3 min-h-[56px] rounded-2xl btn-primary text-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Buy Now via Escrow</span>
      </a>
      <a
        href={AGENT_MAILTO}
        data-track="acquire-contact-agent"
        class="flex-1 sm:flex-none inline-flex items-center justify-center gap-x-3 min-h-[56px] px-8 rounded-2xl btn-secondary"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Speak with Seller</span>
      </a>
    </div>
  </div>

  <p class="text-center text-xs text-muted mt-5 tracking-wide">Serious inquiries only. This is a high-value strategic asset.</p>
</section>
