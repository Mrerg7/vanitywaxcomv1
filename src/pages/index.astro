---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import WhySection from '../components/WhySection.astro';
import AiSection from '../components/AiSection.astro';
import ForSection from '../components/ForSection.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import AcquisitionSection from '../components/AcquisitionSection.astro';
import OfferForm from '../components/OfferForm.astro';
import FaqSection from '../components/FaqSection.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout pathname="/">
  <Nav />
  <main id="main">
    <Hero />
    <TrustBar />
    <WhySection />
    <AiSection />
    <ForSection />
    <OpportunitySection />
    <AcquisitionSection />
    <OfferForm />
    <FaqSection />
    <ClosingCTA />
  </main>
  <Footer />

  <!-- Exit-intent capture (free: no backend, mailto + session snooze) -->
  <div id="exit-intent" class="hidden fixed inset-0 z-[120] items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="exit-title">
    <div id="exit-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div class="relative bg-elevated rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-line">
      <button id="exit-close" type="button" aria-label="Close offer" class="absolute top-3 right-3 w-12 h-12 inline-flex items-center justify-center text-2xl text-muted hover:text-ink rounded-2xl">&times;</button>
      <div class="text-xs font-bold tracking-widest text-accent mb-2">BEFORE YOU GO</div>
      <h2 id="exit-title" class="text-2xl font-bold tracking-tight">Get first refusal on VanityWax.com</h2>
      <p class="mt-2 text-muted text-base">
        One-of-one asset. Leave your email and we&rsquo;ll notify you before accepting any other offer — plus share comparable sales context.
      </p>
      <form id="exit-form" class="mt-5 flex flex-col gap-3">
        <label for="exit-email" class="sr-only">Email address</label>
        <input id="exit-email" type="email" required autocomplete="email" placeholder="you@company.com" class="field" />
        <button type="submit" data-track="exit-submit" class="w-full min-h-[48px] px-6 py-3 bg-accent text-on-dark font-semibold rounded-2xl transition-all hover:brightness-110">Notify Me First</button>
      </form>
      <button id="exit-dismiss" type="button" class="mt-3 w-full min-h-[44px] text-sm text-muted hover:text-ink">No thanks, I&rsquo;ll risk missing it</button>
    </div>
  </div>

  <script is:inline>
    // Theme toggle (persisted, respects OS default; dark is brand default)
    (() => {
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('vanitywax-theme', dark ? 'dark' : 'light');
        } catch (e) {}
      });
    })();

    // Sticky nav appearance on scroll (passive = no scroll jank)
    (() => {
      const nav = document.getElementById('nav');
      if (!nav) return;
      const onScroll = () => {
        nav.classList.toggle('nav-scrolled', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    // Scroll-reveal (respects prefers-reduced-motion, disconnects when done)
    (() => {
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        return;
      }
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    })();

    // Viewing counter (social proof, no backend: deterministic base + session bump)
    (() => {
      const el = document.getElementById('viewer-count');
      if (!el) return;
      const day = Math.floor(Date.now() / 86400000);
      const base = 18 + (day % 14);
      let bump = 0;
      try {
        bump = Number(sessionStorage.getItem('vw-view-bump') || '0');
        if (!bump) {
          bump = 1 + Math.floor(Math.random() * 3);
          sessionStorage.setItem('vw-view-bump', String(bump));
        }
      } catch (e) {}
      el.textContent = `${base + bump} serious inquiries this month from salons, clinics & beauty brands`;
    })();

    // CTA tracking (local log + sendBeacon hook for CF Web Analytics)
    document.querySelectorAll('[data-track]').forEach((el) => {
      el.addEventListener('click', () => {
        const name = el.getAttribute('data-track') || 'cta';
        try {
          const key = 'vanitywax-events';
          const raw = localStorage.getItem(key);
          const arr = raw ? JSON.parse(raw) : [];
          arr.push({ e: name, t: Date.now() });
          localStorage.setItem(key, JSON.stringify(arr.slice(-100)));
        } catch (e) {}
        if (navigator.sendBeacon) {
          try {
            navigator.sendBeacon('/api/track', JSON.stringify({ event: name }));
          } catch (e) {}
        }
      });
    });

    // Copy email (progressive enhancement, no dependency)
    (() => {
      const btn = document.getElementById('copyEmailBtn');
      if (!btn) return;
      const email = 'sales@desertrich.com';
      const done = () => {
        const original = btn.innerHTML;
        btn.innerHTML = '<span>Copied to clipboard!</span>';
        btn.classList.add('bg-emerald-600', 'border-emerald-500');
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('bg-emerald-600', 'border-emerald-500');
        }, 2200);
      };
      btn.addEventListener('click', () => {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(done).catch(() => {
            window.location.href = 'mailto:' + email;
          });
        } else {
          window.location.href = 'mailto:' + email;
        }
      });
    })();

    // Offer form → prefilled mailto (no backend = free)
    (() => {
      const form = document.getElementById('offer-form');
      if (!form) return;
      const err = document.getElementById('form-error');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const name = String(fd.get('name') || '').trim();
        const email = String(fd.get('email') || '').trim();
        const amount = String(fd.get('amount') || '').trim();
        const use = String(fd.get('use') || '').trim();
        const message = String(fd.get('message') || '').trim();
        const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!name || !validEmail) {
          if (err) err.classList.remove('hidden');
          return;
        }
        if (err) err.classList.add('hidden');
        const subject = encodeURIComponent(`Offer for VanityWax.com — ${amount ? '$' + amount : '[Amount]'}`);
        const body = encodeURIComponent(
          `Hi,\n\nI'd like to make an offer for VanityWax.com.\n\nName: ${name}\nEmail: ${email}\nOffer amount (USD): ${amount}\nIntended use: ${use}\nMessage: ${message}\n\nThank you!`
        );
        window.location.href = `mailto:sales@desertrich.com?subject=${subject}&body=${body}`;
      });
    })();

    // Use-case filter chips
    (() => {
      const buttons = document.querySelectorAll('.usecase-filter');
      const cards = document.querySelectorAll('.usecase-card');
      if (!buttons.length || !cards.length) return;
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter') || 'all';
          buttons.forEach((b) => {
            b.classList.remove('bg-accent', 'text-on-dark', 'border-accent');
            b.classList.add('bg-elevated', 'border-line');
          });
          btn.classList.add('bg-accent', 'text-on-dark', 'border-accent');
          btn.classList.remove('bg-elevated', 'border-line');
          cards.forEach((card) => {
            const tags = card.getAttribute('data-tags') || '';
            const show = filter === 'all' || tags === filter;
            card.style.display = show ? '' : 'none';
          });
        });
      });
    })();

    // Mobile menu (accessible: aria-expanded, Esc to close, 48px targets)
    (() => {
      const menuBtn = document.getElementById('mobile-menu-btn');
      if (!menuBtn) return;
      let overlay = null;
      const close = () => {
        overlay?.remove();
        overlay = null;
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', 'Open menu');
        document.body.style.overflow = '';
      };
      menuBtn.addEventListener('click', () => {
        if (overlay) {
          close();
          return;
        }
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', 'Close menu');
        overlay = document.createElement('div');
        overlay.id = 'mobile-menu';
        overlay.className = 'fixed inset-0 bg-black/60 z-[100] md:hidden';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-label', 'Site menu');
        overlay.innerHTML = `
          <div class="bg-surface w-72 max-w-[85vw] h-full p-8 shadow-2xl flex flex-col border-r border-line">
            <div class="flex justify-between items-center mb-10">
              <div class="flex items-center gap-x-2.5">
                <div class="w-9 h-9 bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 rounded-xl flex items-center justify-center">
                  <span class="text-zinc-950 font-black text-lg tracking-tighter">VW</span>
                </div>
                <span class="font-semibold text-xl tracking-tighter">vanitywax<span class="text-xs font-mono text-muted tracking-[2px] ml-0.5">.COM</span></span>
              </div>
              <button type="button" aria-label="Close menu" class="w-12 h-12 inline-flex items-center justify-center text-3xl text-muted hover:text-ink">&times;</button>
            </div>
            <div class="flex flex-col gap-y-1 text-lg font-medium">
              <a href="#why" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">Why This Domain</a>
              <a href="#detail" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">The Industry</a>
              <a href="#for" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">Perfect For</a>
              <a href="#faq" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">FAQ</a>
              <a href="#acquire" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">How to Acquire</a>
              <a href="#offer" class="py-3 px-1 min-h-[48px] inline-flex items-center hover:text-accent border-b border-line">Make an Offer</a>
            </div>
            <div class="mt-auto pt-8 flex flex-col gap-3">
              <a href="#offer" class="flex w-full py-4 min-h-[48px] items-center justify-center bg-accent text-on-dark font-semibold rounded-2xl text-sm text-center">Make an Offer</a>
              <a href="mailto:sales@desertrich.com" class="flex w-full py-4 min-h-[48px] items-center justify-center border border-line font-semibold rounded-2xl text-sm text-center">Email Seller</a>
            </div>
          </div>
        `;
        const mailLink = overlay.querySelector('a[href^="mailto:"]');
        if (mailLink) {
          mailLink.setAttribute(
            'href',
            'mailto:sales@desertrich.com?subject=' + encodeURIComponent('VanityWax.com Domain Acquisition Inquiry')
          );
        }
        document.body.appendChild(overlay);
        document.body.style.overflow = 'hidden';

        overlay.querySelector('button')?.addEventListener('click', close);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) close();
        });
        document.addEventListener('keydown', function esc(e) {
          if (e.key === 'Escape') {
            close();
            document.removeEventListener('keydown', esc);
          }
        });

        overlay.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            const href = link.getAttribute('href');
            close();
            if (href && href.startsWith('#')) {
              setTimeout(() => {
                const target = document.querySelector(href);
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }, 80);
            }
          });
        });
      });
    })();

    // Exit-intent dialog — gated on engagement so it never fires on first paint
    // Triggers: pointer leaves from top (after 20s + mouse entered), 85% scroll
    // after real scrolling + 15s, or 90s time fallback. Once per session.
    (() => {
      const dialog = document.getElementById('exit-intent');
      if (!dialog) return;
      const shownKey = 'vanitywax-exit-shown';
      let shown = false;
      try {
        shown = sessionStorage.getItem(shownKey) === '1';
      } catch (e) {}
      if (shown) return;

      const MIN_MS = 20000;
      const TIME_FALLBACK_MS = 90000;
      const SCROLL_MIN_MS = 15000;
      const SCROLL_DEPTH = 0.85;
      const SCROLL_MIN_PX = 400;

      const startedAt = Date.now();
      let mouseEntered = false;
      let maxScrollDepth = 0;
      let realScrollDistance = 0;
      let lastScrollY = window.scrollY;

      const elapsed = () => Date.now() - startedAt;
      const scrollDepth = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        return max <= 0 ? 1 : (window.scrollY + window.innerHeight) / doc.scrollHeight;
      };

      const show = () => {
        if (!dialog.classList.contains('hidden')) return;
        if (elapsed() < MIN_MS) return;
        dialog.classList.remove('hidden');
        dialog.classList.add('flex');
        try {
          sessionStorage.setItem(shownKey, '1');
        } catch (e) {}
        document.getElementById('exit-email')?.focus();
      };
      const hide = () => {
        dialog.classList.add('hidden');
        dialog.classList.remove('flex');
      };

      document.getElementById('exit-close')?.addEventListener('click', hide);
      document.getElementById('exit-dismiss')?.addEventListener('click', hide);
      document.getElementById('exit-backdrop')?.addEventListener('click', hide);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hide();
      });

      // Desktop exit intent: pointer leaves the viewport from the top edge.
      // mouseleave is far more reliable than mouseout (no child-element noise).
      const onLeave = (e) => {
        if (!mouseEntered) return;
        if (elapsed() < MIN_MS) return;
        if (document.activeElement && document.activeElement !== document.body) return;
        const y = e.clientY ?? (e.relatedTarget ? -1 : 0);
        if (y <= 0) show();
      };
      document.documentElement.addEventListener('mouseleave', onLeave);
      document.addEventListener('mouseenter', () => {
        mouseEntered = true;
      });

      // Scroll fallback: only after the visitor has actually explored the page.
      const onScroll = () => {
        const y = window.scrollY;
        const delta = Math.abs(y - lastScrollY);
        lastScrollY = y;
        if (delta > 0) realScrollDistance += delta;

        const depth = scrollDepth();
        if (depth > maxScrollDepth) maxScrollDepth = depth;

        if (elapsed() < SCROLL_MIN_MS) return;
        if (realScrollDistance < SCROLL_MIN_PX) return;
        if (depth >= SCROLL_DEPTH) show();
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      // Time fallback: long enough that only a genuine visitor hits it.
      setTimeout(show, TIME_FALLBACK_MS);

      document.getElementById('exit-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = document.getElementById('exit-email');
        const email = input ? String(input.value || '').trim() : '';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          input?.focus();
          return;
        }
        window.location.href = `mailto:sales@desertrich.com?subject=${encodeURIComponent('First Refusal Request — VanityWax.com')}&body=${encodeURIComponent('Hi,\n\nPlease add me to the first-refusal list for VanityWax.com.\n\nMy email: ' + email + '\n\nThank you!')}`;
        hide();
      });
    })();

    console.log('%c[VanityWax.com] Premium domain landing page ready.', 'color:#fbbf24');
  </script>
</BaseLayout>
